{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  // The *.regress.ts harnesses are dev scripts run with tsx, never shipped.
  // highlightPrompt.regress.ts imports the frontend's tool definitions on
  // purpose — the tool descriptions are part of what it regresses — and that
  // path sits outside this project's rootDir, so the build skips them.
  "exclude": ["node_modules", "dist", "src/**/*.regress.ts"]
}
