# =============================================================================
# Monorepo shared environment
# Copy this file to .env at the repo root.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
PORT=3000
DATABASE_URL=tuning-movie.db
AGENT_RELAY_LOG_ENABLED=false
FIXED_CURRENT_DATE=2026-03-11
# Session-token signing secret. Generate one: openssl rand -hex 32
# Left unset, a random per-process secret is used, so every backend restart
# invalidates every live session and view token. docker-compose.yml forwards
# this, so setting it here is what makes a redeploy survivable for open sessions.
STUDY_SESSION_SECRET=
STUDY_SESSION_TTL_MS=14400000
# Public demo mode: max simultaneous demo sessions. Demo sessions never evict
# each other; creation beyond this cap is rejected with a clear error.
# A non-numeric value falls back to 10.
DEMO_MAX_CONCURRENT_SESSIONS=10
# Demo sessions get their own (shorter) lifetime, and are reaped once idle, so a
# visitor who simply closes the tab releases their demo slot and agent process.
DEMO_SESSION_TTL_MS=3600000
DEMO_SESSION_IDLE_TIMEOUT_MS=900000
# DEMO_TRACE_ENABLED is gone. Demo recording is now the visitor's decision, made
# on the setup screen: tick the research-recording box and the session writes an
# interaction log and a planner trace under logs/demo/; leave it and nothing at
# all is written. No environment variable can override either answer.
# LAB ONLY. Lets the unauthenticated /speech/synthesize-preview speaker test fall
# back to OPENAI_API_KEY when no visitor key was entered. Leave false on any
# public deployment: it makes the operator key spendable by anyone.
#
# This is NOT needed for access-code visitors. A visitor who has typed a valid
# booth code gets the speaker test on the operator key anyway: the code is
# verified (read-only, not a redemption) through the same brute-force limiter,
# the server speaks its own fixed sample, and successful code-backed previews
# are capped per minute (SPEECH_PREVIEW_CODE_MAX_PER_MINUTE, default 60).
SPEECH_PREVIEW_ALLOW_ENV_KEY=false
SPEECH_PREVIEW_CODE_MAX_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# Read from THIS file (both Vite configs set envDir to the repo root), so a dev
# run honours them -- but no value here can reach a container build: .dockerignore
# excludes **/.env and no Dockerfile declares a matching ARG. The deployed bundle
# therefore always uses the compiled-in fallbacks, which is why VITE_AGENT_WS_URL
# below is harmless in production (the bundle derives wss://<page host>/agent/ws).
VITE_API_URL=
VITE_FIXED_CURRENT_DATE=2026-03-11
VITE_AGENT_WS_URL=ws://localhost:3000/agent/ws
VITE_AGENT_SESSION_ID=default
VITE_MONITOR_API_BASE=/monitor-api

# -----------------------------------------------------------------------------
# Tuning Agent
# -----------------------------------------------------------------------------
AGENT_RELAY_URL=ws://localhost:3000/agent/ws
AGENT_SESSION_ID=default
AGENT_STUDY_ID=pilot-01
AGENT_PARTICIPANT_ID=P00-EXAMPLE

# OpenAI (enabled by default — set AGENT_ENABLE_OPENAI=false to disable)
#
# The paper's user study ran with gpt-5.4. The compiled-in default is now
# gpt-5.6-terra: replayed against the study's own planner traces it matched
# gpt-5.4's tool choice 42/46, inside gpt-5.4's own 43-44/46 run-to-run spread,
# at the same latency and ~20% lower cost. Set AGENT_OPENAI_MODEL=gpt-5.6-terra to
# reproduce the paper's setup. gpt-5.6-sol scored identically to terra while
# costing twice as much and running a third slower, so it is not the default.
#
# OPENAI_API_KEY has two legitimate settings, depending on how visitors are
# credentialed. This file used to say only the first, while the access-code
# section further down says enabling codes REQUIRES a key -- pick one:
#
#   1. Bring-your-own-key (DEMO_ACCESS_CODES_ENABLED=false): leave this EMPTY.
#      Every visitor pastes their own key in the browser.
#   2. Access codes (DEMO_ACCESS_CODES_ENABLED=true, what maestro.cs.vt.edu
#      runs): this key MUST be set -- redeeming a code attaches it to one
#      session server-side and the visitor never sees it. Use a key minted for
#      the demo alone, in its own OpenAI project with a hard budget limit set in
#      the dashboard; that project cap is the only ceiling that survives a bug
#      in this application. Keep SPEECH_PREVIEW_ALLOW_ENV_KEY and
#      ALLOW_OPERATOR_KEY_FALLBACK false -- both would make this key spendable
#      through an unauthenticated route. docker-compose.yml pins them false for
#      the container regardless of what this file says.
OPENAI_API_KEY=
# The server-wide default. A demo visitor can override it for their own
# session from the settings sheet (apps/tuning-agent/src/llm/plannerModels.ts is
# the allow-list, GPT-6 included); study conditions always run on this value.
AGENT_OPENAI_MODEL=gpt-5.6-terra
AGENT_OPENAI_API_MODE=responses
AGENT_ENABLE_OPENAI=true
# Speech generation for the pre-session speaker check only. OPENAI_TTS_SPEED is
# also what the agent uses to estimate reading time in text mode.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_FORMAT=wav
OPENAI_TTS_SPEED=1.5

# Voice mode (OpenAI Realtime over browser WebRTC). The backend mints a
# short-lived client secret with this config baked in; the browser never sees
# the real key. create_response is forced off server-side so the realtime model
# stays a voice I/O layer and the tuning agent remains the only decision maker.
#
# Because of that, the mini tier is the default: the model only speaks the
# agent's text and yields on barge-in, and full gpt-realtime-2.1 charges 3.2x
# per audio token ($32/$64 vs $10/$20 per 1M) for the same job.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# The realtime model only repeats the agent's sentence, so it gets the lowest
# reasoning rung. minimal | low | medium | high | xhigh.
OPENAI_REALTIME_REASONING_EFFORT=minimal
# marin/cedar are OpenAI's quality picks; alloy matches the published study.
OPENAI_REALTIME_VOICE=alloy
# Clamped to 1.5 max: realtime's range is narrower than /audio/speech's.
OPENAI_REALTIME_SPEED=1.0
OPENAI_REALTIME_STT_MODEL=gpt-4o-mini-transcribe
# Server-side noise reduction on the mic stream. near_field for a headset or
# earbuds (AirPods), far_field for a room mic on a table, off to disable.
OPENAI_REALTIME_NOISE_REDUCTION=near_field
# Server-side turn detection. Raise the threshold if the agent's own voice
# through open speakers keeps triggering barge-in; lower the silence window if
# turns feel sluggish (the old client-side VAD held 1400ms).
#
# A loud hall (KSEA poster session, 2026-10-24, near_field and 0.5): hall noise
# and bystanders opened a "speech" over the agent constantly. 40 of the agent's
# 128 sentences were cut by a VAD barge-in (and 25 more by a transcript that
# followed), the opening question was killed within 0.3 s in 3 of 6 sessions,
# and 55 "no active response" cancel errors were each a barge-in race.
# Recommended for a booth: OPENAI_REALTIME_VAD_THRESHOLD=0.7 (unmeasured in a
# hall; measure with a hall-noise WAV through CHROMIUM_EXTRA_FLAGS first), and a
# close-talk headset. Low-content transcripts no longer stop the agent's
# sentence (booth only, ChatPage), but a barge-in happens at speech START,
# before any transcript exists, so only the threshold or the VAD type changes it.
OPENAI_REALTIME_VAD_THRESHOLD=0.5
OPENAI_REALTIME_VAD_SILENCE_MS=900
OPENAI_REALTIME_VAD_PREFIX_MS=300
# server_vad (default: what the study ran) or semantic_vad, which ends a turn on
# what was said rather than on silence and ignores the three values above. With
# eagerness=low it waits longest before deciding the visitor has finished, the
# Realtime docs' setting for "let the user speak uninterrupted" — worth trying in
# a hall (unmeasured: whether it also starts fewer barge-ins on noise).
#OPENAI_REALTIME_VAD_TYPE=semantic_vad
#OPENAI_REALTIME_VAD_EAGERNESS=low
# Push-to-talk (booth only) is NOT an env setting: it is the settings sheet's
# "Push to talk" toggle, which makes the kiosk request
# POST /speech/realtime-session {"turnDetection":"manual"}. That session is
# minted with turn_detection=null (no VAD at all; the browser commits the audio
# buffer when the key is released) and is otherwise identical: same voice,
# transcription model, noise reduction and create_response=false. The backend
# refuses "manual" with 403 PUSH_TO_TALK_DEMO_ONLY for any non-demo session, so
# a study session always gets the VAD above. docs/scenarios/booth-ptt-setup.md.
# Only needs to outlive the WebRTC handshake, not the conversation.
REALTIME_TOKEN_TTL_SECONDS=600

# Conference demo access codes. A single-use six-character code, printed on a
# card and handed out at the booth, lets one visitor run one demo session on the
# operator's key without ever seeing it. Codes are generated with
#   npx tsx scripts/demo-access-codes.ts generate --count 120 --batch my-event
# and stored in apps/backend/.runtime/demo-access-codes.db.
#
# Enabling this REQUIRES OPENAI_API_KEY to be set for the backend. Use a key
# minted for the demo alone, in its own OpenAI project with a hard budget limit
# set in the OpenAI dashboard: that project cap is the only ceiling that
# survives a bug in this application.
DEMO_ACCESS_CODES_ENABLED=false
# Default lifetime for a generated code. 0 = never expires.
# An explicit --valid-from/--valid-until window overrides this.
DEMO_ACCESS_CODE_TTL_HOURS=24
# Brute-force limits on redemption. Six characters from a 30-symbol alphabet is
# 7.29e8 combinations, which only protects anything if guessing is slow.
#
# CAVEAT for the podman/nginx deployment: the backend sets no trustProxy, and
# rootless podman's published-port forwarder rewrites the source address, so
# request.ip is nginx's own container IP for every visitor. The per-IP bucket is
# therefore one bucket for the whole internet, and because the per-IP branch
# trips at 10 before the global branch reaches 100, 10 is the real
# deployment-wide ceiling: ten wrong codes from anyone locks out every visitor
# for IP_WINDOW_MS. Raising MAX_FAILURES_PER_IP above MAX_GLOBAL_FAILURES makes
# the deployment-wide tier the one that governs, which is at least the tier
# whose message and size were written for that job.
DEMO_ACCESS_MAX_FAILURES_PER_IP=10
DEMO_ACCESS_IP_WINDOW_MS=600000
DEMO_ACCESS_MAX_GLOBAL_FAILURES=100
DEMO_ACCESS_GLOBAL_WINDOW_MS=600000

# Let a session with no key of its own fall back to the operator's OPENAI_API_KEY.
# MUST stay false on any public deployment: POST /study/sessions is
# unauthenticated and only *demo* sessions require a key, so with this on anyone
# could create a non-demo session and spend the operator key. Set it to true
# only for a private lab deployment where the researcher creates every session.
ALLOW_OPERATOR_KEY_FALLBACK=false

# Agent debug & monitor
AGENT_LLM_DEBUG=false
# Optional override. Leave empty to use defaults:
# true in non-production, false in production.
AGENT_MONITOR_ENABLED=
# Whether the live Agent Monitor (the SSE feed on AGENT_MONITOR_PORT) gets a
# copy of every LLM request/response. That is ALL it controls. The
# `*.llm-trace.jsonl` research record is written whenever the visitor ticked the
# consent checkbox, whatever this says: until 2026-10-17 the two shared one gate
# inside the emitters and a backend started with this false wrote no trace file
# for consented sessions. Not forwarded by docker-compose.yml, so a container
# runs the code default (true); demo sessions have no monitor to feed anyway.
AGENT_MONITOR_LLM_TRACE=true
AGENT_MONITOR_PORT=3500

# -----------------------------------------------------------------------------
# Companion phone (the second device that acts as the session's mic)
# -----------------------------------------------------------------------------
# Lifetime of a companion token and the rate limit on minting them. This
# credential can open OpenAI Realtime sessions against the session's key, so the
# window matters. Defaults shown; docker-compose.yml forwards all four.
COMPANION_TOKEN_TTL_MINUTES=60
COMPANION_MINT_WINDOW_MINUTES=10
COMPANION_MINTS_PER_WINDOW=12

# How long to wait when validating a visitor-supplied OpenAI key.
OPENAI_KEY_VALIDATION_TIMEOUT_MS=5000

# Debug/test hooks, not deployment settings, listed so they are not mistaken for
# missing configuration:
#   AGENT_SUPERVISOR_DISABLED=true   stops all agent spawning (warns on stderr only)
#   AGENT_MONITOR_PORT_OVERRIDE      pins the per-session monitor port
#   STUDY_UI_ORDER_SEED              fixes the study UI ordering seed
