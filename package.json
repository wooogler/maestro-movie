{
  "name": "tuning-movie",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:stack:system",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:agent": "AGENT_MONITOR_PORT_OVERRIDE=3500 bash scripts/run-tuning-agent.sh",
    "dev:monitor": "npm run dev --workspace=apps/agent-monitor",
    "dev:stack:system": "node scripts/dev-orchestrator.mjs system",
    "dev:stack:agent": "node scripts/dev-orchestrator.mjs agent",
    "dev:stack:agent-monitor": "node scripts/dev-orchestrator.mjs agent_monitor",
    "dev:stack:all": "node scripts/dev-orchestrator.mjs all",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:agent": "npm run build --workspace=apps/tuning-agent",
    "build:monitor": "npm run build --workspace=apps/agent-monitor",
    "start:agent": "bash scripts/run-tuning-agent.sh start",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:seed:scenarios": "npm run db:seed:scenarios --workspace=apps/backend",
    "scenarios:generate": "npm run scenarios:generate --workspace=apps/backend --",
    "cards:build": "python3 scripts/build-demo-cards.py",
    "codes": "tsx scripts/demo-access-codes.ts",
    "codes:generate": "tsx scripts/demo-access-codes.ts generate",
    "codes:stats": "tsx scripts/demo-access-codes.ts stats",
    "codes:revoke": "tsx scripts/demo-access-codes.ts revoke",
    "check": "npm run check:schema && npm run check:barrier && npm run check:voice && npm run check:language && npm run check:planner-language && npm run check:llm-trace && npm run check:layout && npm run check:logpaths && npm run check:codes && npm run check:scopes && npm run check:memory && npm run check:devices && npm run check:preferences && npm run check:navigation && npm run check:cards && npm run check:planner-prompt && npm run check:planner-models && npm run check:speech-sync && npm run check:repeat-guard && npm run check:endtime && npm run check:endtime-sim && tsx apps/tuning-agent/src/llm/extractorPrompt.check.ts && tsx apps/tuning-agent/src/core/emptyRespond.check.ts",
    "check:schema": "tsx --tsconfig apps/backend/tsconfig.check.json apps/backend/src/db/schemaMigration.check.ts",
    "check:barrier": "tsx apps/tuning-agent/src/core/speechBarrier.check.ts",
    "check:voice": "tsx apps/frontend/src/voice/smartSkip.check.ts",
    "voice:validate": "tsx scripts/validate-voice-classifier.ts",
    "check:language": "tsx apps/frontend/src/i18n/language.check.ts",
    "check:planner-language": "tsx apps/tuning-agent/src/llm/languagePrompt.check.ts",
    "check:llm-trace": "tsx apps/tuning-agent/src/llm/llmTrace.check.ts",
    "check:layout": "tsx apps/frontend/src/components/chat/fullTuningLayout.check.ts",
    "check:logpaths": "tsx apps/backend/src/study/logPaths.check.ts",
    "check:codes": "tsx apps/backend/src/study/demoAccessCodes.check.ts",
    "check:scopes": "tsx apps/backend/src/study/relayTokenScopes.check.ts",
    "check:memory": "tsx scripts/check-memory-snapshot.ts",
    "check:devices": "tsx apps/frontend/src/study/devicePresence.check.ts",
    "check:preferences": "tsx --tsconfig apps/frontend/tsconfig.app.json apps/frontend/src/components/memory/preferencePanel.dom.check.ts",
    "check:scenarios": "tsx apps/backend/src/db/generator/generateScenarioDataset.ts --verify",
    "typecheck": "tsc --noEmit -p apps/backend/tsconfig.json && tsc -p apps/backend/tsconfig.check.json && tsc --noEmit -p apps/tuning-agent/tsconfig.json && tsc --noEmit -p apps/frontend/tsconfig.app.json && tsc --noEmit -p apps/frontend/tsconfig.node.json && tsc --noEmit -p apps/frontend/tsconfig.check-dom.json",
    "check:navigation": "tsx apps/tuning-agent/src/core/navigationMemory.check.ts",
    "check:speech-sync": "tsx --tsconfig apps/frontend/tsconfig.node.json apps/frontend/src/voice/speechGuiSync.check.ts",
    "check:planner-prompt": "tsx apps/tuning-agent/src/llm/plannerPrompt.check.ts",
    "check:planner-models": "tsx apps/frontend/src/agent/plannerModels.check.ts",
    "check:endtime": "tsx --tsconfig apps/frontend/tsconfig.node.json apps/frontend/src/spec/endTimeFilter.check.ts",
    "check:endtime-sim": "tsx apps/tuning-agent/src/core/filterSimulation.check.ts",
    "check:repeat-guard": "tsx apps/tuning-agent/src/core/repeatGuard.check.ts",
    "check:cards": "tsx --tsconfig apps/frontend/tsconfig.node.json apps/frontend/src/study/quickDemoCards.check.ts",
    "regress:extractor": "tsx apps/tuning-agent/src/llm/extractorPrompt.regress.ts",
    "regress:highlight": "tsx apps/tuning-agent/src/llm/highlightPrompt.regress.ts",
    "regress:stalefilter": "tsx apps/tuning-agent/src/llm/staleFilterPrompt.regress.ts",
    "regress:brevity": "tsx apps/tuning-agent/src/llm/spokenBrevity.regress.ts",
    "regress:decisive": "tsx apps/tuning-agent/src/llm/decisiveSelection.regress.ts"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
